[TEMPLATE]
# ── Site ─────────────────────────────────────────────────────────────
# Public URL of the site (used for Paystack callbacks, sitemap, SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────
# Create a project at https://supabase.com, then run supabase/schema.sql
# in the SQL editor. Until these are set, the app runs in DEMO MODE with
# seeded sample data so you can explore every screen.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key (Dashboard → Project Settings → API). Never exposed to
# the browser. Used for admin operations + storage uploads.
SUPABASE_SERVICE_ROLE_KEY=

# ── Paystack ─────────────────────────────────────────────────────────
# https://dashboard.paystack.com/#/settings/developers
# Secret key is server-only. Webhook endpoint: /api/paystack/webhook
PAYSTACK_SECRET_KEY=
# Optional, defaults to NGN. Amounts are verified against this on activation.
PAYSTACK_CURRENCY=NGN
